{
  "name": "aos",
  "version": "0.0.0",
  "private": true,
  "description": "Amaze Operating System — internal operating system for Amaze Loans Pvt Ltd",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed:permissions": "vitest run src/domain/permissions/seed.test.ts -u",
    "predev": "node Backend/free-dev-ports.mjs",
    "dev": "concurrently -k -n vite,api,storage,mail -c blue,cyan,green,magenta \"vite\" \"vite-node --config vite.server.config.ts Backend/api-server.ts\" \"node Backend/storage-server.mjs\" \"node Backend/mail-server.mjs\"",
    "dev:e2e": "concurrently -k -n vite,api -c blue,cyan \"vite\" \"npm run api-server\"",
    "test:e2e": "playwright test",
    "api-server": "vite-node --config vite.server.config.ts Backend/api-server.ts",
    "seed-users": "vite-node --config vite.server.config.ts Backend/seed-users.ts",
    "bootstrap-production": "vite-node --config vite.server.config.ts Backend/bootstrap-production.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "node Backend/migrate.mjs",
    "migrate:status": "node Backend/migrate.mjs --status",
    "storage-server": "node Backend/storage-server.mjs",
    "mail-server": "node Backend/mail-server.mjs",
    "web-server": "node Backend/web-server.mjs",
    "start:production": "node Backend/supervisor.mjs",
    "backup": "node Backend/backup.mjs",
    "backup:verify": "node Backend/backup-verify.mjs",
    "restore": "node Backend/restore.mjs",
    "restore-drill": "vite-node --config vite.server.config.ts Backend/restore-drill.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck:frontend": "tsc --noEmit -p Frontend/tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
